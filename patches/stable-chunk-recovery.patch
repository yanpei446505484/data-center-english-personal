diff --git a/src/lib/chunkRecovery.ts b/src/lib/chunkRecovery.ts
new file mode 100644
index 0000000..c1e3c07
--- /dev/null
+++ b/src/lib/chunkRecovery.ts
@@ -0,0 +1,64 @@
+const RELOAD_MARKER = 'dc_chunk_reload_at';
+const RELOAD_COOLDOWN_MS = 30_000;
+
+/** Browser messages differ, so keep all known dynamic-import failure forms here. */
+export function isChunkLoadError(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error ?? '');
+  const normalized = message.toLowerCase();
+
+  return normalized.includes('failed to fetch dynamically imported module') ||
+    normalized.includes('error loading dynamically imported module') ||
+    normalized.includes('importing a module script failed') ||
+    normalized.includes('loading chunk') ||
+    normalized.includes('loading css chunk') ||
+    normalized.includes('chunkloaderror');
+}
+
+async function clearStaleAppResources() {
+  if ('serviceWorker' in navigator) {
+    const registrations = await navigator.serviceWorker.getRegistrations();
+    await Promise.all(registrations.map((registration) => registration.unregister()));
+  }
+
+  if (typeof caches !== 'undefined') {
+    const cacheNames = await caches.keys();
+    await Promise.all(
+      cacheNames
+        .filter((name) => name.startsWith('dc-english-'))
+        .map((name) => caches.delete(name)),
+    );
+  }
+}
+
+/** Clear stale app resources and reload the current hash route from the latest build. */
+export async function recoverFromChunkLoad(force = false): Promise<boolean> {
+  const now = Date.now();
+  let lastReload = 0;
+
+  try {
+    lastReload = Number(sessionStorage.getItem(RELOAD_MARKER) || 0);
+  } catch {
+    // Storage may be blocked in privacy mode; recovery should still proceed.
+  }
+
+  if (!force && lastReload > 0 && now - lastReload < RELOAD_COOLDOWN_MS) {
+    return false;
+  }
+
+  try {
+    sessionStorage.setItem(RELOAD_MARKER, String(now));
+  } catch {
+    // Ignore storage failures.
+  }
+
+  try {
+    await clearStaleAppResources();
+  } catch {
+    // A reload with a cache-busting query remains useful even if cleanup fails.
+  }
+
+  const url = new URL(window.location.href);
+  url.searchParams.set('_appv', String(now));
+  window.location.replace(url.toString());
+  return true;
+}
diff --git a/src/lib/chunkRecovery.test.ts b/src/lib/chunkRecovery.test.ts
new file mode 100644
index 0000000..3bae419
--- /dev/null
+++ b/src/lib/chunkRecovery.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest';
+import { isChunkLoadError } from './chunkRecovery';
+
+describe('isChunkLoadError', () => {
+  it.each([
+    'Failed to fetch dynamically imported module: /assets/page.js',
+    'error loading dynamically imported module',
+    'Importing a module script failed.',
+    'Loading chunk 12 failed.',
+    'Loading CSS chunk 4 failed.',
+    'ChunkLoadError: missing chunk',
+  ])('recognizes %s', (message) => {
+    expect(isChunkLoadError(new Error(message))).toBe(true);
+  });
+
+  it('does not hide ordinary rendering errors', () => {
+    expect(isChunkLoadError(new Error('Cannot read properties of undefined'))).toBe(false);
+  });
+});
