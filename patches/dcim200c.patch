   {id:2120,speaker:"Engineer",en:"I will escort the vendor to Room 101.",cn:"我会陪同供应商去 101 房间。",ipa:"/…/",tags:["第120句","PTW与供应商管理","★★★★★"],when:"工程师汇报执行结果或提出操作问题。",words:[{w:"vendor",ipa:"/ˈvɛndər/",pos:"名词",cn:"供应商；承包商",memory:"vend(出售)+or(人)→出售东西的人→供应商",phonics:"ven 读 /vɛn/，dor 读 /dər/",collocations:[["vendor access","供应商进入"],["vendor management","供应商管理"],["notify vendor","通知供应商"]],examples:[["Tell the vendor to wait.","通知供应商等待。"],["The vendor has arrived.","供应商已到。"]]},{w:"escort",ipa:"/ˈɛskɔːrt/",pos:"动词/名词",cn:"陪同；护送",memory:"es(出)+cort(队伍)→随行队伍→陪同",phonics:"es 读 /ɛs/，cort 读 /kɔːrt/",collocations:[["escort the vendor","陪同供应商"],["escort to site","陪同到现场"]],examples:[["Escort the vendor to Room 101.","陪同供应商去101房间。"],["I will escort the vendor.","我会陪同供应商。"]]}],phrases:[{p:"will escort the",ipa:"",cn:"PTW与供应商管理相关表达",why:"\"will escort the\" 是本句的核心表达，在数据中心PTW与供应商管理场景中高频使用。"}],grammar:[{q:"I will + 动词原形 表示什么？",a:"will 表示「将要/会」，用于表达即将执行的操作。\n✅ I will check it now.（我现在就去检查。）\n✅ I will dispatch a technician.（我会派技术员。）\n在工作场景中，I will 表示承诺和执行力。"}],pattern:"I + 动作 + 对象 + 结果/状态",patternExamples:[{en:"I have completed the inspection.",cn:"我已经完成了检查。",words:[]},{en:"I will notify the vendor.",cn:"我会通知供应商。",words:[]},{en:"I have updated the shift log.",cn:"我已更新交班日志。",words:[]}],thinking:"英语汇报句型：I + 动作 + 结果。\n中文说「我已经做了XX」，英语同样：I have done X / I will do X。\n注意 I have + 过去分词 = 已经做完（现在完成时），I will + 动词原形 = 将要做。",pronunciation:"数字清晰读出。\n保持语速平稳，关键词适当加重。",quiz:[{q:"把「我会陪同供应商去 101 房间。」用英语说出来。",a:"I will escort the vendor to Room 101."},{q:"「供应商；承包商」用英语怎么说？",a:"vendor (/ˈvɛndər/)"}]},
